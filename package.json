{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Implementação do https://www.tabnews.com.br para o https://curso.dev",
  "repository": "https://github.com/diasjoaovitor/clone-tabnews.git",
  "author": "João Vitor <jvitordiass@outlook.com.br>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "trap 'exit 130' INT TERM; trap 'pnpm services:down' EXIT; pnpm services:up && pnpm services:wait:database && pnpm migrations:up && next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest --run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest --run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "next typegen && tsc --noEmit",
    "services:up": "docker compose -f src/infra/compose.yml up -d",
    "services:stop": "docker compose -f src/infra/compose.yml stop",
    "services:down": "docker compose -f src/infra/compose.yml down",
    "services:wait:database": "node src/infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -m src/infra/migrations create",
    "migrations:up": "node-pg-migrate -m src/infra/migrations --envPath .env.development up",
    "migrations:up:dry": "node-pg-migrate -m src/infra/migrations --envPath .env --dry-run up",
    "migrations:up:deploy": "node-pg-migrate -m src/infra/migrations --envPath .env up",
    "eslint:check": "eslint",
    "eslint:fix": "eslint --fix",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "shadcn:add": "pnpm dlx shadcn@latest add",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@tanstack/react-form": "1.33.5",
    "@vercel/functions": "3.10.3",
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "dedent": "1.7.2",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "node-pg-migrate": "7.9.1",
    "nodemailer": "10.2.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "setimmediate": "1.0.5",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0",
    "uuid": "11.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@eslint/json": "2.1.0",
    "@eslint/markdown": "8.0.3",
    "@faker-js/faker": "9.9.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/async-retry": "1.4.9",
    "@types/node": "24.13.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "2.11.30",
    "commitlint-config-emoji-convention": "1.0.3",
    "dotenv": "18.0.8",
    "dotenv-expand": "1000.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prefer-arrow-functions": "3.10.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "eslint-plugin-unicorn": "74.0.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "set-cookie-parser": "3.2.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.x"
  }
}
