{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Implementação do https://www.tabnews.com.br para o https://curso.dev",
  "repository": "https://github.com/diasjoaovitor/clone-tabnews.git",
  "author": "João Vitor <jvitordiass@outlook.com.br>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "./init.sh",
    "build": "next build",
    "start": "next start",
    "test": "./init.sh test",
    "type-check": "next typegen && tsc --noEmit",
    "test:watch": "jest --runInBand --watchAll --verbose",
    "services:up": "docker compose -f src/infra/compose.yml up -d",
    "services:stop": "docker compose -f src/infra/compose.yml stop",
    "services:down": "docker compose -f src/infra/compose.yml down",
    "services:wait:database": "node src/infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -m src/infra/migrations create",
    "migrations:up": "node-pg-migrate -m src/infra/migrations --envPath .env.development up",
    "migrations:up:dry": "node-pg-migrate -m src/infra/migrations --envPath .env --dry-run up",
    "migrations:up:deploy": "node-pg-migrate -m src/infra/migrations --envPath .env up",
    "eslint:check": "eslint",
    "eslint:fix": "eslint --fix",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.3",
    "dedent": "1.7.2",
    "next": "16.3.5",
    "node-pg-migrate": "7.9.1",
    "nodemailer": "10.2.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "setimmediate": "1.0.5",
    "uuid": "11.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@eslint/json": "2.1.0",
    "@eslint/markdown": "8.0.3",
    "@faker-js/faker": "9.9.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/async-retry": "1.4.9",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "2.11.30",
    "commitlint-config-emoji-convention": "1.0.3",
    "concurrently": "10.0.6",
    "cross-fetch": "4.1.0",
    "dotenv": "18.0.8",
    "dotenv-expand": "1000.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-prefer-arrow-functions": "3.10.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unicorn": "74.0.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "set-cookie-parser": "3.2.1",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.x"
  }
}
